# Учетные данные GigaChat (Base64 clientId:clientSecret)
GIGACHAT_CREDENTIALS=your_base64_credentials_here

# Область доступа (GIGACHAT_API_PERS для физических лиц, GIGACHAT_API_CORP для корпоративных клиентов)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель GigaChat по умолчанию (GigaChat-3-Ultra, GigaChat-Max, GigaChat-Pro, GigaChat-Lite)
GIGACHAT_MODEL=GigaChat-3-Ultra

# Игнорировать проверку самоподписанных сертификатов Минцифры / Сбера
GIGACHAT_VERIFY_SSL_CERTS=False

# Авторизация локального OpenAI-прокси
GPT2GIGA_ENABLE_API_KEY_AUTH=True
GPT2GIGA_API_KEY=sk-gigachat

# Режим контракта GigaChat (v2 для инструментов и стриминга)
GPT2GIGA_GIGACHAT_API_MODE=v2

# Принудительно использовать выбранную модель GigaChat вместо имени модели OpenAI от клиента
GPT2GIGA_PASS_MODEL=False

# Отключить reasoning поля для совместимости с агентами Codex / Continue
GPT2GIGA_DISABLE_REASONING=True

# Автоматический повтор запросов при ошибках 429 (Too Many Requests)
GIGACHAT_MAX_RETRIES=5
GIGACHAT_RETRY_BACKOFF_FACTOR=1.0
GIGACHAT_TIMEOUT=60.0

# Лимит параллельных запросов к GigaChat (1 для личных аккаунтов GIGACHAT_API_PERS)
# Остальные запросы автоматически ждут в очереди без падений по 429
GPT2GIGA_MODEL_MAX_CONNECTIONS_DEFAULT=1
GPT2GIGA_MODEL_MAX_CONNECTIONS_ACQUIRE_TIMEOUT=60.0
